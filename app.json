{
  "expo": {
    "name": "OraCare",
    "slug": "oracare",
    "version": "0.1.0",
    "scheme": "oracare",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05061B",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "edu.upenn.spot.oral"
    },
    "android": {
      "package": "edu.upenn.spot.oral",
      "adaptiveIcon": {
        "backgroundColor": "#05061B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "OraCare",
      "shortName": "OraCare",
      "description": "Oral-health readings, food logging and scan history in one place."
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a food or nutrition-label photo for your log.",
          "cameraPermission": "Take a food or nutrition-label photo for your log.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "description": "Oral-health readings, food logging and scan history in one place."
  }
}
